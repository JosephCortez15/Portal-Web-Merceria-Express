# Copia este archivo como .env y completa tus datos. El .env NUNCA se sube a GitHub.
PORT=3000

# Cadena de conexión de Neon (panel de Neon → Connect)
DATABASE_URL=postgresql://neondb_owner:TU_CLAVE@ep-xxxx-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon exige SSL
DB_SSL=true

# Direcciones que pueden llamar a la API, separadas por coma y sin "/" al final
# (Live Server usa el puerto 5500; GitHub Pages es la página publicada)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://josephcortez15.github.io